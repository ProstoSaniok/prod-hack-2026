LOCAL_DEMO_SEED=false
DEMO_ORGANIZER_PASSWORD=

GITEA_INTERNAL_API_URL=
GITEA_API_TOKEN=

OTEL_SERVICE_NAME=backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
