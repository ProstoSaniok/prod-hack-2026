{
  "name": "prod-hack-2026-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0 --poll 1000 --live-reload",
    "build": "ng build",
    "test": "playwright test",
    "test:fixtures": "PRODGUILD_E2E_SUITE=fixtures playwright test",
    "test:live": "PRODGUILD_E2E_SUITE=live playwright test",
    "test:historical": "PRODGUILD_E2E_SUITE=historical playwright test",
    "test:report": "playwright show-report playwright-report/fixtures",
    "lint": "npm run lint:code && npm run lint:styles && npm run format:check",
    "lint:code": "eslint . --max-warnings=0",
    "lint:styles": "stylelint \"src/**/*.css\" --max-warnings=0",
    "lint:fix": "npm run format && npm run lint:code -- --fix && npm run lint:styles -- --fix && npm run format",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/animations": "20.2.0",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.2.0",
    "@angular/compiler": "20.2.0",
    "@angular/core": "20.2.0",
    "@angular/forms": "20.2.0",
    "@angular/platform-browser": "20.2.0",
    "@angular/router": "20.2.0",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@taiga-ui/core": "4.30.0",
    "@taiga-ui/event-plugins": "4.7.0",
    "@taiga-ui/kit": "4.30.0",
    "codemirror": "6.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.2.2",
    "@angular/cli": "20.2.2",
    "@angular/compiler-cli": "20.2.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.64.1",
    "angular-eslint": "20.7.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "typescript": "~5.8.0",
    "typescript-eslint": "8.71.2"
  }
}
