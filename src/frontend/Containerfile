ARG NODE_IMAGE=registry.spirit.t-education.com/cicd-images/nodejs-20:latest
ARG NGINX_IMAGE=registry.spirit.t-education.com/cicd-images/nginx:1.27-alpine

FROM ${NODE_IMAGE} AS builder

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --no-audit --no-fund

COPY angular.json tsconfig.json tsconfig.app.json ./
COPY src ./src
COPY public ./public

# angular.json has no named production configuration.
RUN npm run build -- --optimization --output-hashing=all --source-map=false

FROM ${NGINX_IMAGE}

RUN rm -rf /usr/share/nginx/html/*
COPY --from=builder /app/dist/prod-hack-2026/browser /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:80/ || exit 1

CMD [ "nginx", "-g", "daemon off;" ]
